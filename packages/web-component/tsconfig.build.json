{
  // tsup's declaration bundling: not a composite project, and the internal
  // packages resolve to source so their types are inlined without a prior tsc -b.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@appswyldesolutions/vcv-core": ["../core/src/index.ts"],
      "@appswyldesolutions/vcv-renderer": ["../renderer/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
