{
  "name": "@appswyldesolutions/vcv-web-component",
  "version": "1.0.0",
  "description": "<value-chain-visualiser>: a glass-and-spheres KPI visual for business-process value chains, as a web component.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vcv.iife.js",
  "jsdelivr": "./dist/vcv.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./define": {
      "import": {
        "types": "./dist/define.d.ts",
        "default": "./dist/define.js"
      },
      "require": {
        "types": "./dist/define.d.cts",
        "default": "./dist/define.cjs"
      }
    },
    "./browser": "./dist/vcv.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/define.js",
    "./dist/define.cjs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:10,retryDelay:200})\" && tsup",
    "prepack": "npm run build"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "kpi",
    "value-chain"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppsWyldeSolutions/value-chain-visualiser.git",
    "directory": "packages/web-component"
  },
  "homepage": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/tree/main/packages/web-component#readme",
  "bugs": {
    "url": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@appswyldesolutions/vcv-core": "^1.0.0",
    "@appswyldesolutions/vcv-renderer": "^1.0.0"
  }
}
