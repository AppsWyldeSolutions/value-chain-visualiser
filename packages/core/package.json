{
  "name": "@appswyldesolutions/vcv-core",
  "version": "1.0.0",
  "description": "Value chain KPI logic for the Value Chain Visualiser: row ingestion, on-target evaluation and the grouped model. No DOM, no framework.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/testHelpers.*"
  ],
  "scripts": {
    "build": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true,maxRetries:10,retryDelay:200})\" && tsc -b",
    "prepack": "npm run build"
  },
  "keywords": [
    "kpi",
    "value-chain"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppsWyldeSolutions/value-chain-visualiser.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
