{
  "name": "@appswyldesolutions/vcv-renderer",
  "version": "2.0.0",
  "description": "Vanilla DOM/SVG/CSS renderer for the Value Chain Visualiser: glass cards, spheres, connectors and controls drawn from the core model.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "licenses",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/testHelpers.*"
  ],
  "scripts": {
    "build": "node -e \"for (const p of ['dist','tsconfig.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true,maxRetries:10,retryDelay:200})\" && tsc -b",
    "prepack": "npm run build"
  },
  "keywords": [
    "kpi",
    "value-chain",
    "svg"
  ],
  "author": "Wylde Solutions Pty Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppsWyldeSolutions/value-chain-visualiser.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/tree/main/packages/renderer#readme",
  "bugs": {
    "url": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dependencies": {
    "@appswyldesolutions/vcv-core": "^1.0.0"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "jsdom": "^30.1.2"
  }
}
