{
  "name": "value-chain-visualiser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b && npm run typecheck -w packages/powerbi-visual",
    "test": "vitest run",
    "build": "npm run build -w packages/core -w packages/renderer -w packages/web-component -w packages/react -w packages/powerbi-visual -w packages/tableau-extension",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e:consumers": "node scripts/consumers.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "release": "npm run verify && node scripts/release.mjs",
    "postinstall": "node scripts/link-powerbi-api.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppsWyldeSolutions/value-chain-visualiser.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AppsWyldeSolutions/value-chain-visualiser/issues"
  },
  "homepage": "https://github.com/AppsWyldeSolutions/value-chain-visualiser#readme",
  "private": "true",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
